{
  "name": "@odingard/guardian-openclaw",
  "version": "0.1.0",
  "description": "Guardian for OpenClaw: a native plugin whose before_tool_call hook sends every consequential tool call (exec, file edits, messages, browser, MCP tools such as Composio) to Guardian for a deterministic ALLOW/ASK/DENY decision. Deploys, destructive commands and outbound actions wait for a human approval on your phone; every allowed call carries a verifiable receipt. Fails closed.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json",
    "./openclaw.plugin.json": "./openclaw.plugin.json"
  },
  "files": [
    "dist",
    "openclaw.plugin.json",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "guardian",
    "agent-governance",
    "approvals"
  ],
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build && npm test"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.7.1",
      "minGatewayVersion": "2026.7.1"
    },
    "build": {
      "openclawVersion": "2026.7.1"
    }
  },
  "devDependencies": {
    "@odingard/guardian-sdk": "^0.3.5",
    "@types/node": "^22",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Odingard/guardian-sdk.git",
    "directory": "packages/openclaw"
  },
  "homepage": "https://guardian.odingard.com"
}
