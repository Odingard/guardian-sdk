{
  "name": "@odingard/guardian-mcp",
  "version": "0.3.3",
  "mcpName": "io.github.Odingard/guardian-mcp",
  "description": "MCP server that routes an agent's tool calls through Guardian — the human authority layer for autonomous AI. Every tool call gets a deterministic ALLOW/ASK/DENY decision before anything executes; ASK holds for human approval, DENY never runs, every outcome carries a verifiable receipt.",
  "license": "Apache-2.0",
  "author": "Odingard Security LLC",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "guardian-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "server.json"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node22 --external:@odingard/guardian-sdk --external:@modelcontextprotocol/sdk --outfile=dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@odingard/guardian-sdk": "^0.3.8"
  },
  "devDependencies": {
    "@types/node": "^22",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Odingard/guardian-sdk.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://odingard.com/guardian"
}
