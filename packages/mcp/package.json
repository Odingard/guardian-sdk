{
  "name": "@odingard/guardian-mcp",
  "version": "0.5.2",
  "mcpName": "io.github.Odingard/guardian-mcp",
  "description": "Puts Guardian in front of MCP tool calls: allow, ask a person, or deny before the call runs.",
  "license": "Apache-2.0",
  "author": "Odingard Security LLC",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "guardian-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "server.json"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node22 --external:@odingard/guardian-sdk --external:@modelcontextprotocol/sdk --outfile=dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@odingard/guardian-sdk": "^0.6.0"
  },
  "devDependencies": {
    "@types/node": "^22",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Odingard/guardian-sdk.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://odingard.com/guardian",
  "keywords": [
    "guardian",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "mcp-proxy",
    "ai-agents",
    "agent-security",
    "authorization",
    "human-in-the-loop",
    "x402"
  ]
}
