{
  "name": "@odingard/guardian-vercel-ai",
  "version": "0.4.0",
  "description": "Vercel AI SDK adapter — route an agent's tool calls through Guardian for a deterministic ALLOW/ASK/DENY decision before anything executes.",
  "license": "Apache-2.0",
  "author": "Odingard Security LLC",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist-dts/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "dist-dts",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node22 --external:ai --external:@odingard/guardian-sdk --outfile=dist/index.js && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build && npm test"
  },
  "peerDependencies": {
    "@odingard/guardian-sdk": "^0.4.0",
    "ai": "^5.0.0 || ^6.0.0 || ^7.0.0"
  },
  "devDependencies": {
    "@odingard/guardian-sdk": "^0.4.0",
    "@types/node": "^22.20.5",
    "ai": "^7.0.159",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "guardian",
    "ai-agents",
    "authorization",
    "authority",
    "vercel-ai-sdk",
    "human-in-the-loop"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Odingard/guardian-sdk.git",
    "directory": "packages/vercel-ai"
  },
  "homepage": "https://odingard.com/guardian"
}
