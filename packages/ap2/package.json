{
  "name": "@odingard/guardian-ap2",
  "version": "0.1.0",
  "description": "Guardian for AP2 (Agent Payments Protocol v0.2): Guardian decides closed Checkout and Payment Mandates (ALLOW/ASK/DENY on the exact terms) before the agent key signs them.",
  "license": "Apache-2.0",
  "author": "Odingard Security LLC",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist-dts/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "dist-dts",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && esbuild src/index.ts --bundle --platform=node --format=esm --target=node22 --external:@odingard/guardian-sdk --outdir=dist && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build && npm test"
  },
  "peerDependencies": {
    "@odingard/guardian-sdk": "^0.4.1 || ^0.5.0"
  },
  "devDependencies": {
    "@odingard/guardian-sdk": "^0.4.1 || ^0.5.0",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "guardian",
    "ap2",
    "agent-payments",
    "payments",
    "ai-agents",
    "authorization",
    "human-in-the-loop"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Odingard/guardian-sdk.git",
    "directory": "packages/ap2"
  },
  "homepage": "https://odingard.com/guardian"
}
